# Variables de entorno de Nexoru Op.
# Este archivo solo lista NOMBRES. Nunca escribas aquí un valor real.
# Copia este archivo a .env.local (ignorado por git) y rellena los valores.
#
# Local:      los valores salen de `npx supabase status` y de Mailpit (sin usuario ni contraseña).
# Producción: se cargan en Vercel → Settings → Environment Variables (quickstart §4).

# URL del proyecto Supabase. Local: "API URL" de `supabase status` (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (publishable key). Local: "Publishable key" de `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (solo servidor). Local: "Secret key" de `supabase status`.
# En producción se marca como Sensitive en Vercel.
SUPABASE_SECRET_KEY=

# URL pública de la app. Local: http://localhost:3000 · Producción: https://op.nexoru.ai
APP_URL=

# SMTP para invitaciones y avisos.
# Local (Mailpit): SMTP_HOST=127.0.0.1, SMTP_PORT=54325, SMTP_USER y SMTP_PASSWORD vacíos.
# Producción (Resend): smtp.resend.com, 465, usuario "resend", contraseña = API key de Resend.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Remitente. Ejemplo: Nexoru Op <no-reply@nexoru.ai>
EMAIL_FROM=
