# Variables de entorno de Nexoru Op.
# Este archivo solo lista NOMBRES. Nunca escribas aquí un valor real.
#
# Hay dos entornos, cada uno con su archivo (ambos ignorados por git):
#   .env.local     → pruebas y desarrollo (Supabase en 127.0.0.1:54321, app en 127.0.0.1:3000)
#   .env.op.local  → uso diario del Dueño (Supabase en 127.0.0.1:55321, app en 127.0.0.1:3200)
# Los valores salen de `npx supabase status` (pruebas) o `npx supabase status --workdir ops` (uso).
# Nexoru Op no envía correos: no hay variables de correo.

# URL de la API de Supabase local ("API URL").
# Pruebas: http://127.0.0.1:54321 · Uso: http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("Publishable key").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta ("Secret key"). Solo servidor; nunca en el navegador.
SUPABASE_SECRET_KEY=

# URL de la app. Pruebas: http://127.0.0.1:3000 · Uso: http://127.0.0.1:3200
APP_URL=

# Carpeta del portafolio que lee el dashboard. Uso: /home/fili/proyectos (en .env.op.local).
# Las pruebas la generan solas en una carpeta temporal; no la pongas en .env.local.
PROJECTS_ROOT=

# Token de GitHub, opcional: fine-grained y de SOLO LECTURA (Fase 4).
# Va solo en .env.op.local (entorno de uso), nunca en .env.local ni en el repo.
# Cómo crearlo con los permisos mínimos: specs/004-github-readonly/quickstart.md (Parte 2).
# Sin token, el dashboard consulta solo los repos públicos (60 consultas por hora).
GITHUB_TOKEN=

# Solo pruebas E2E: origen del GitHub simulado (http://127.0.0.1:<puerto>). Nunca en uso:
# en el entorno de uso la app se niega a arrancar si está definida.
GITHUB_API_ORIGIN=
